{
	"name": "b13/stderr-logging",
	"type": "typo3-cms-extension",
	"description": "Stderr Logging - Sends all TYPO3 log output as JSON lines to stderr instead of var/log/, so Kubernetes and other container platforms collect it. Install it, done: no configuration needed.",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"TYPO3 CMS",
		"logging",
		"stderr",
		"json",
		"kubernetes",
		"docker",
		"container"
	],
	"homepage": "https://b13.com",
	"authors": [
		{
			"name": "b13 GmbH",
			"email": "typo3@b13.com",
			"homepage": "https://b13.com",
			"role": "Developer"
		}
	],
	"support": {
		"issues": "https://github.com/b13/stderr-logging/issues",
		"source": "https://github.com/b13/stderr-logging"
	},
	"require": {
		"php": "^8.2",
		"typo3/cms-core": "^13.4 || ^14.3 || ^15.0"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"require-dev": {
		"phpstan/phpstan": "^2.1",
		"typo3/coding-standards": "^0.5.5",
		"typo3/testing-framework": "^8.2 || ^9.0 || dev-main"
	},
	"replace": {
		"typo3-ter/stderr-logging": "self.version"
	},
	"config": {
		"vendor-dir": ".Build/vendor",
		"bin-dir": ".Build/bin",
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"sort-packages": true
	},
	"autoload": {
		"psr-4": {
			"B13\\StderrLogging\\": "Classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"B13\\StderrLogging\\Tests\\": "Tests/"
		}
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "stderr_logging",
			"web-dir": ".Build/Web",
			"app-dir": ".Build",
			"version": "0.1.0",
			"Package": {
				"providesPackages": {}
			}
		}
	}
}
